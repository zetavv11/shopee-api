NODE_ENV=development
PORT=3001

# Kunci API gateway ini (buat sendiri, minimal 16 karakter acak). BUKAN token ShopeePay.
API_KEY=replace_with_a_long_random_secret

# ---- Sesi Partner Portal (https://partner.shopee.co.id/shopeepay-portal/transactions) ----
# Ini BUKAN kredensial merchant resmi: sesi login portal milik akunmu sendiri, bisa mati kapan saja.
# Cara termudah: jalankan gateway, lalu kirim hasil "Copy as cURL (bash)" request get-transaction-list
# ke POST /update-session (lihat README). Atau isi lewat env di bawah.
#
# Cookie portal: nilai cookie __shopee_partner_website_x_token_live (JWT), ATAU "nama=nilai; nama2=nilai2"
# (header Cookie lengkap dari DevTools). Token "B:..." diambil otomatis dari JWT.
SHOPEE_COOKIE=
# Token "B:..." (data.metadata.token di payload). Opsional bila SHOPEE_COOKIE berisi JWT.
SHOPEE_TOKEN=
# URL LENGKAP request get-transaction-list dari DevTools (kolom Request URL). WAJIB (atau pakai SHOPEE_API_BASE).
SHOPEE_TRANSACTIONS_URL=

# Notifikasi Telegram (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# QRIS statis milik merchant sendiri (untuk menyuntikkan nominal). Kosongkan untuk menonaktifkan /create-qris.
QRIS_STATIC=

# Lokasi berkas database JSON. Kosong = ./database.json (lokal) atau /tmp/database.json (Vercel).
# DATABASE_FILE=

# Rahasia untuk /cron/tick bila memakai Vercel Cron (minimal 16 karakter). Cron eksternal cukup pakai X-API-Key.
# CRON_SECRET=

# ---------------- Opsional ----------------
# Alternatif SHOPEE_TRANSACTIONS_URL: base URL + path hasil capture akun kamu sendiri
# SHOPEE_API_BASE=
# SHOPEE_LIST_PATH=/get-transaction-list
# SHOPEE_ORIGIN=https://partner.shopee.co.id
# SHOPEE_USER_AGENT=            # isi dengan User-Agent browser yang kamu pakai login (opsional)
# PROVIDER_PAGE_SIZE=10         # portal membatasi ukuran halaman (praktik: maks 10)
# PROVIDER_MAX_PAGES=10
# Masa tenggang (menit) setelah invoice kedaluwarsa karena mutasi portal bisa tertunda beberapa menit
# INVOICE_GRACE_MINUTES=10

# URL publik gateway untuk membentuk qris_url (disarankan di produksi)
# PUBLIC_BASE_URL=

# INVOICE_TTL_MINUTES=15
# MIN_AMOUNT=1
# MAX_AMOUNT=10000000

# Kode unik Rp1..N ditambahkan ke nominal agar tidak bentrok (0 = nonaktif)
# UNIQUE_CODE_MAX=0

# RATE_LIMIT_PER_MIN=120
# MIN_CHECK_INTERVAL_SECONDS=5

# Pemantauan pembayaran otomatis (detik, minimal 5; 0 = nonaktif). Hanya berlaku di server biasa (lokal/VPS).
# Di Vercel worker ini tidak jalan: gunakan /cron/tick dan /check-payment.
# WATCH_INTERVAL_SECONDS=10

# Callback ke website/bot saat invoice lunas (wajib https di produksi). Secret minimal 16 karakter.
# CALLBACK_URL=https://websitekamu.com/api/payment-callback
# CALLBACK_SECRET=
# CALLBACK_MAX_ATTEMPTS=10

# true = QRIS baru dengan nominal sama menggantikan (EXPIRED-kan) yang masih PENDING. Hanya untuk TESTING;
# di produksi pakai UNIQUE_CODE_MAX agar tiap invoice punya nominal berbeda.
# REPLACE_PENDING_SAME_AMOUNT=true

# LOG_LEVEL=info


# ── Dashboard pribadi (/dashboard) ───────────────────────────────────────────
# Bawaan: zeetasi / zeetasi@124 bila dikosongkan. GANTI untuk produksi.
DASHBOARD_ENABLED=true
DASH_USER=zeetasi
DASH_PASS=zeetasi@124
DASH_SESSION_HOURS=12
# Opsional: rahasia penanda tangan cookie sesi (jika kosong diturunkan dari API_KEY + password)
SESSION_SECRET=
BRAND_NAME=Zeetasi Pay

# Kode unik hanya untuk nominal >= nilai ini (Rp1 tetap Rp1)
UNIQUE_CODE_MIN_AMOUNT=1000

# ── Penyimpanan tahan lama (opsional, Upstash Redis REST / Vercel KV) ────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REMOTE_STORE_KEY=zeetasi-pay:db
# REMOTE_READ_TTL_MS=3000
